# LinkShield External API Configuration
# Never commit your actual keys to version control!

# VirusTotal API Key (Get free key from https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API Key (Get from Google Cloud Console)
GOOGLE_SAFE_BROWSING_API_KEY=

# PhishTank API Key (Optional, increases rate limits: https://phishtank.org/)
PHISHTANK_API_KEY=
